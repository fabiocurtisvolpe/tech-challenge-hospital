

input ConsultaFilter {
    id: ID
    status: String
    pacienteNome: String
    medicoNome: String
    dataInicio: String
    dataFim: String
}

type Query {
    historicoConsulta(filter: ConsultaFilter): [ConsultaAud]
}

type ConsultaAud {
    id: ID
    rev: Int
    revtype: Int
    dataHora: String
    diagnostico: String
    prescricao: String
    pacienteNome: String
    medicoNome: String
    especialidadeNome: String
    status: String
    valor: Float
}

type Usuario {
    id: ID
    nome: String
    email: String
}

type Especialidade {
    id: ID
    nome: String
}