type Query {
    historicoConsulta(id: ID): [ConsultaAud]
}

type ConsultaAud {
    id: ID
    rev: Int
    revtype: Int
    diagnostico: String
    prescricao: String
    paciente: Usuario
    medico: Usuario
    especialidade: Especialidade
}

type Usuario {
    id: ID
    nome: String
    email: String
}

type Especialidade {
    id: ID
    nome: String
}