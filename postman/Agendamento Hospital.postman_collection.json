                  "// Verifica se a requisição teve sucesso (Status 200)",
                  "if (pm.response.code === 200) {",
                  "    // O token vem diretamente no body como string (não é JSON)",
                  "    var token = pm.response.text();",
                  "    ",
                  "    // Salva o token na variável de ambiente",
